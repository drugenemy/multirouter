# Copy to .env and paste your keys. Empty = provider is skipped.
# Format: KEY=value, no quotes, no spaces.
# Sign-up links are in README.md. Every key is optional.

NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=
LLM7_API_KEY=

# Local password between claude-free and the router. Made for you on first run.
LITELLM_MASTER_KEY=
